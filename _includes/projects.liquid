<div class="col">
  <article class="card h-100 hoverable project-card">
    {% if project.img %}
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes = "250px"
        alt="project thumbnail"
        class="card-img-top"
      %}
    {% endif %}
    <div class="card-body">
      {% capture project_index %}0{{ forloop.index }}{% endcapture %}
      <p class="project-index">{{ project.category | upcase }} · {{ project_index | slice: -2, 2 }}</p>
      <h2 class="card-title">
        <a
          class="stretched-link project-card-link"
          href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}"
        >
          {{- project.title -}}
        </a>
      </h2>
      <p class="card-text">{{ project.description }}</p>
      {% if project.github %}
        <div class="project-card-actions">
          <a
            class="project-github-link"
            href="{{ project.github }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Code repository for {{ project.title }}"
            data-toggle="tooltip"
            title="Code repository"
          >
            <i class="fa-brands fa-github gh-icon" aria-hidden="true"></i>
            {% if project.github_stars %}
              <span class="stars" data-toggle="tooltip" title="GitHub stars">
                <i class="fa-solid fa-star" aria-hidden="true"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </a>
        </div>
      {% endif %}
    </div>
  </article>
</div>
